# Provider keys — read by LiteLLM, not by the API. Only the one named by
# LLM_MODEL in litellm/config.yaml has to be set.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# The credential the backend presents to the LiteLLM proxy (compose passes it as
# LLM_API_KEY). sk-local is fine locally; generate a real one for a public host,
# e.g. `openssl rand -hex 32`.
LITELLM_MASTER_KEY=sk-local

# A model_name from litellm/config.yaml: gpt-4o-mini, groq-oss or gemini-flash.
LLM_MODEL=groq-oss

# --- docker-compose.prod.yml only (see docs/DEPLOY.md) ---

# Postgres password. Required in production; the local compose file hardcodes
# `sarjy` instead. Generate one, e.g. `openssl rand -hex 16`.
POSTGRES_PASSWORD=

# The domain Caddy requests a certificate for. Must already resolve to this
# host's public IP before the stack starts, or issuance fails.
SITE_DOMAIN=yourname.duckdns.org
