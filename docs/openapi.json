{
  "openapi": "3.1.0",
  "info": {
    "title": "Sarjy API",
    "description": "\nBackend for **Sarjy**, a voice assistant that remembers things across sessions.\n\nSpeech-to-text and text-to-speech both run in the browser via the Web Speech\nAPI, so this API only ever handles text.\n\n### Identity\n\nThere is no authentication. `user_id` is a UUID generated by the browser and\nkept in `localStorage`; the server accepts it as given. Reads are scoped by it\nand return `404` for another user's session, which prevents accidental\ncross-user reads rather than determined ones. This is a deliberate tradeoff for\na demo, recorded in the project's PRD.\n\n### Sessions\n\nA session row is created lazily, on its first message, so empty conversations\nnever reach the database. Deleting a session removes its messages but preserves\nany memories learned in it \u2014 durable facts outlive the conversation that taught\nthem.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Report that the API process is running.\n\nDeliberately does not touch the database: this is the target of the\nplatform's health check, and a slow database should not cycle the service.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Always `{\"status\": \"ok\"}` when the process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send a message and get Sarjy's reply",
        "description": "Run one conversational turn.\n\nCreates the user and session rows if they are new, persists the incoming\nmessage, replays the recent history along with everything Sarjy remembers\nabout this user, and returns the reply.\n\nThe model may call `save_memory` during the turn to record a durable fact.\nThat write is committed as part of the same turn and is visible to every\nlater session for this user.\n\nOutbound model calls pass through a token-bucket limiter that makes callers\nwait rather than rejecting them, so a busy server shows up as latency.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sarjy's reply text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "A path or query id is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The model could not be reached, even after retries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List a user's conversations",
        "description": "Return every session belonging to this user, ordered by `updated_at`\ndescending. Sessions with no messages yet do not appear, because their row\ndoes not exist until the first turn.",
        "operationId": "list_sessions_api_sessions_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`.",
              "examples": [
                "3f1a9c2e-5b7d-4e88-9a21-6c0f4d8b1e33"
              ],
              "title": "User Id"
            },
            "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`."
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions, most recently active first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionOut"
                  },
                  "title": "Response List Sessions Api Sessions Get"
                }
              }
            }
          },
          "400": {
            "description": "A path or query id is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Read a conversation's transcript",
        "description": "Return the full transcript for one session, oldest first.\n\nThis is the whole conversation, not the windowed slice replayed to the\nmodel on each turn -- that window is capped by `chat_history_limit`.",
        "operationId": "list_messages_api_sessions__session_id__messages_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The conversation's UUID.",
              "examples": [
                "b74e2f10-8c3a-4d61-9f52-1a7e0c9d4b88"
              ],
              "title": "Session Id"
            },
            "description": "The conversation's UUID."
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`.",
              "examples": [
                "3f1a9c2e-5b7d-4e88-9a21-6c0f4d8b1e33"
              ],
              "title": "User Id"
            },
            "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`."
          }
        ],
        "responses": {
          "200": {
            "description": "Messages in chronological order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageOut"
                  },
                  "title": "Response List Messages Api Sessions  Session Id  Messages Get"
                }
              }
            }
          },
          "400": {
            "description": "A path or query id is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such session for this user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Rename a conversation",
        "description": "Replace the session's title.\n\nTitles are otherwise derived from the first user message. A rename is\npermanent -- later turns do not overwrite it.",
        "operationId": "rename_session_api_sessions__session_id__patch",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The conversation's UUID.",
              "examples": [
                "b74e2f10-8c3a-4d61-9f52-1a7e0c9d4b88"
              ],
              "title": "Session Id"
            },
            "description": "The conversation's UUID."
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`.",
              "examples": [
                "3f1a9c2e-5b7d-4e88-9a21-6c0f4d8b1e33"
              ],
              "title": "User Id"
            },
            "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "400": {
            "description": "A path or query id is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such session for this user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "sessions"
        ],
        "summary": "Delete a conversation",
        "description": "Delete a session and its messages.\n\nMemories learned during the conversation are kept, with their\n`source_session_id` set to null. Durable facts about the user are not the\nconversation's to take with it.",
        "operationId": "remove_session_api_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The conversation's UUID.",
              "examples": [
                "b74e2f10-8c3a-4d61-9f52-1a7e0c9d4b88"
              ],
              "title": "Session Id"
            },
            "description": "The conversation's UUID."
          },
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`.",
              "examples": [
                "3f1a9c2e-5b7d-4e88-9a21-6c0f4d8b1e33"
              ],
              "title": "User Id"
            },
            "description": "The browser's UUID, from `localStorage` under `sarjy_user_id`."
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted. No body."
          },
          "400": {
            "description": "A path or query id is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such session for this user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Client-generated UUID identifying the browser."
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Client-generated UUID for the conversation. The row is created on the first message, so a session the user has opened but not written in does not exist server-side yet."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "The user's turn, typed or transcribed."
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "message"
        ],
        "title": "ChatRequest",
        "example": {
          "message": "What's the weather like?",
          "session_id": "b74e2f10-8c3a-4d61-9f52-1a7e0c9d4b88",
          "user_id": "3f1a9c2e-5b7d-4e88-9a21-6c0f4d8b1e33"
        }
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "Sarjy's reply. Spoken aloud by the client unless muted."
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatResponse",
        "example": {
          "reply": "It's 34\u00b0C and clear in Riyadh right now."
        }
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "example": {
          "detail": "user_id must be a UUID"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Either `user` or `assistant`. Tool calls are not persisted."
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "MessageOut"
      },
      "SessionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Derived from the first user message, or set by a rename."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Touched on every turn. Drives the sidebar's ordering."
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "SessionOut"
      },
      "SessionUpdate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "description": "The new session title."
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "SessionUpdate",
        "example": {
          "title": "Trip planning"
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness, for the platform's health check."
    },
    {
      "name": "chat",
      "description": "One conversational turn."
    },
    {
      "name": "sessions",
      "description": "Conversation history: list, read, rename, delete."
    }
  ]
}
