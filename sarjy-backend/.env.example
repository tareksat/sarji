DATABASE_URL=postgresql+psycopg://sarjy:sarjy@localhost:5432/sarjy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# To route through the LiteLLM proxy (docker-compose service), set LLM_BASE_URL
# and switch OPENAI_MODEL to a model_name from litellm/config.yaml (gpt-4o-mini,
# groq-oss, gemini-flash). LLM_API_KEY must match LITELLM_MASTER_KEY in the
# root .env.
LLM_BASE_URL=
LLM_API_KEY=
CORS_ORIGIN=http://localhost:5173
LLM_RATE_LIMIT_PER_MINUTE=20
CHAT_HISTORY_LIMIT=20
LLM_RETRY_BACKOFF_SECONDS=[1,2]
LOG_LEVEL=INFO
MCP_SERVER_URL=http://localhost:8100/mcp
