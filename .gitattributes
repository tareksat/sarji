# The container's entrypoint is read by /bin/sh. A CRLF shebang fails there with
# "no such file or directory", so this file must stay LF on every platform.
start.sh text eol=lf

# Same for the droplet provisioner: it is fetched and run directly on Linux.
droplet-init.sh text eol=lf

# And for the redeploy script, run on the droplet by the same shell.
deploy.sh text eol=lf
